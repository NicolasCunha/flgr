# Copy this file to .env and adjust as needed (see docs/architecture/adr/0010
# and docs/architecture/adr/0012). .env is gitignored.

FLGR_HTTP_PORT=8080
FLGR_DB_PATH=./data/flgr.db
# false only for local HTTP development — must be true in production.
FLGR_SESSION_COOKIE_SECURE=false
FLGR_KAFKA_BROKERS=kafka:9092
FLGR_LOG_LEVEL=debug
# Generate your own with: openssl rand -base64 32
FLGR_ENCRYPTION_KEY=i9j9rbW8N1dN+WY+3V7eom2wJ0J9YaNrdNgxcNHjujY=

# The first User is created via the web UI's setup wizard on first run
# (GET/POST /api/v1/setup), not an env var — see
# docs/business/requirements/0002-user-management.md.
